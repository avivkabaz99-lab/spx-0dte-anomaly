# Copy to .env and fill from your password manager. NEVER commit .env.
# Paste values from the editor, not via shell (avoids shell history).

# ---- Supabase ----
# Project settings -> API
SUPABASE_URL=
# anon key: safe to expose in the frontend, RLS is what protects the data
SUPABASE_ANON_KEY=
# service_role key: FULL DB ACCESS, bypasses RLS. Backend only. Never in web/.
SUPABASE_SERVICE_ROLE_KEY=
# Project settings -> Database -> Connection string (for RLS tests)
SUPABASE_DB_URL=

# ---- IBKR ----
# 7497 = TWS paper | 7496 = TWS live | 4001 = IB Gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11

# ---- Execution ----
# null | paper | ibkr   -- 'null' is read-only: logs signals, places no orders.
BROKER_MODE=null
